# MorphOS native PPC (ppc-morphos-gcc 11)
set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR ppc)
set(AJ_TARGET morphos-ppc)
set(CMAKE_C_COMPILER   ppc-morphos-gcc)
set(CMAKE_CXX_COMPILER ppc-morphos-g++)
set(CMAKE_AR           ppc-morphos-ar)
set(CMAKE_RANLIB       ppc-morphos-ranlib)
set(CMAKE_C_FLAGS_INIT   "-noixemul")
set(CMAKE_CXX_FLAGS_INIT "-noixemul -fno-exceptions -fno-rtti")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-noixemul")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
